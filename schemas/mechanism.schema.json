{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tmzncty.github.io/mechanical-computing-playground/schemas/mechanism.schema.json",
  "title": "Mechanical Computing Mechanism State",
  "type": "object",
  "required": ["mechanismId", "state", "events"],
  "properties": {
    "mechanismId": { "type": "string", "minLength": 1 },
    "state": { "type": "object" },
    "events": { "type": "array", "items": { "type": "object", "required": ["type", "sequence"] } }
  },
  "additionalProperties": true
}
